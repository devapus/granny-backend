# ---------------------------------------------------------------
# House of Memories backend - environment template.
# Copy to .env for local dev. On Vercel set these in Project Settings.
# NEVER commit real values.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- MongoDB Atlas (required in production) ---
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=house_of_memories

# --- Web / CORS ---
# Comma-separated list of allowed frontend origins (required in production)
FRONTEND_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the app (Vercel = 1)
TRUST_PROXY=1

# --- Sessions / CSRF (required in production; min 32 chars each) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CSRF_SECRET=
SESSION_TTL_HOURS=12
# lax (same-site frontend/backend) | strict | none (cross-site, requires HTTPS)
COOKIE_SAMESITE=lax
# Optional, e.g. .example.com
COOKIE_DOMAIN=

# --- Admin bootstrap (only used when no administrator exists) ---
ADMIN_BOOTSTRAP_EMAIL=
# min 12 characters
ADMIN_BOOTSTRAP_PASSWORD=

# --- Cloudflare R2 (media endpoints return 503 until all required values are set) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional custom endpoint (defaults to https://<account>.r2.cloudflarestorage.com)
R2_ENDPOINT=
# Optional public bucket / custom domain base URL for public media, e.g. https://media.example.com
R2_PUBLIC_BASE_URL=
UPLOAD_URL_TTL_SECONDS=600
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=209715200

# --- Rate limits (per IP, per instance) ---
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_TRIBUTE_MAX=5
RATE_LIMIT_TRIBUTE_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000

# --- Docs ---
# Serve Swagger UI at /api/docs (default: enabled outside production)
ENABLE_DOCS=true
